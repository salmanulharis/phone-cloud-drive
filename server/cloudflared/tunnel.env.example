# Cloudflare Tunnel settings used by setup-tunnel.sh.
# Copy to tunnel.env and fill in your own values:  cp tunnel.env.example tunnel.env

# A name for the tunnel in your Cloudflare account
TUNNEL_NAME=phone-drive

# Public hostname for the web drive (your domain must use Cloudflare DNS)
DRIVE_HOSTNAME=drive.example.com

# Public hostname for WebDAV (map it as a network drive). Leave empty to skip.
DAV_HOSTNAME=dav.example.com
