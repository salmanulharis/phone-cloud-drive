# ~/.cloudflared/config.yml - generated by setup-tunnel.sh; shown here for reference.
tunnel: 00000000-0000-0000-0000-000000000000
credentials-file: /data/data/com.termux/files/home/.cloudflared/00000000-0000-0000-0000-000000000000.json
# Many mobile/home networks block QUIC (UDP); HTTP/2 avoids a slow fallback on every start.
protocol: http2
ingress:
  # The admin panel and REST API are never exposed publicly (home Wi-Fi only).
  - hostname: drive.example.com
    path: ^/(web/admin|api/)
    service: http_status:404
  - hostname: drive.example.com
    service: http://localhost:8080
  - hostname: dav.example.com
    service: http://localhost:10080
  - service: http_status:404
