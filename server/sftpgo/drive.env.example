# Drive (SFTPGo) settings.
# install.sh copies this file to ~/sftpgo-ui/drive.env; ~/bin/start-drive loads it.
# Restart the drive after editing:  pkill -f '^sftpgo serve'; ~/bin/start-drive
# Every value maps to a key in $PREFIX/etc/sftpgo/sftpgo.json (SFTPGO_SECTION__KEY=value).

# --- storage / UI -----------------------------------------------------------
# Where user folders live. A dot-folder plus .nomedia keeps files out of Gallery/media apps.
export SFTPGO_DATA_PROVIDER__USERS_BASE_DIR=/sdcard/.CloudDrive
export SFTPGO_WEBDAVD__BINDINGS__0__PORT=10080
# Patched copies of SFTPGo's templates/static files (created by install-ui.sh)
export SFTPGO_HTTPD__TEMPLATES_PATH=$HOME/sftpgo-ui/templates
export SFTPGO_HTTPD__STATIC_FILES_PATH=$HOME/sftpgo-ui/static
# Count storage usage for every user (default 2 = only users with a quota)
export SFTPGO_DATA_PROVIDER__TRACK_QUOTA=1

# --- persistent, secure web sessions ----------------------------------------
# Fixed signing key => logins survive SFTPGo restarts and phone reboots.
# The key file is generated automatically (mode 600) by start-drive.
export SFTPGO_HTTPD__SIGNING_PASSPHRASE_FILE=$HOME/.sftpgo-signing.key
# Web login lifetime in minutes. 720 (12 h) is the maximum SFTPGo accepts;
# higher values are silently ignored and it falls back to 20. Renewed while in use.
export SFTPGO_HTTPD__COOKIE_LIFETIME=720
# 1 = don't bind a login to one IP (phones switch between Wi-Fi and mobile data)
export SFTPGO_HTTPD__TOKEN_VALIDATION=1

# --- real client IPs from the Cloudflare tunnel (trusted only from localhost) ---
export SFTPGO_HTTPD__BINDINGS__0__PROXY_ALLOWED=127.0.0.1,::1
export SFTPGO_HTTPD__BINDINGS__0__CLIENT_IP_PROXY_HEADER=CF-Connecting-IP
export SFTPGO_WEBDAVD__BINDINGS__0__PROXY_ALLOWED=127.0.0.1,::1
export SFTPGO_WEBDAVD__BINDINGS__0__CLIENT_IP_PROXY_HEADER=CF-Connecting-IP

# --- security headers (also makes the session cookie "Secure" behind HTTPS) ----
export SFTPGO_HTTPD__BINDINGS__0__SECURITY__ENABLED=true
export SFTPGO_HTTPD__BINDINGS__0__SECURITY__HTTPS_PROXY_HEADERS__0__KEY=X-Forwarded-Proto
export SFTPGO_HTTPD__BINDINGS__0__SECURITY__HTTPS_PROXY_HEADERS__0__VALUE=https
export SFTPGO_HTTPD__BINDINGS__0__SECURITY__STS_SECONDS=31536000
export SFTPGO_HTTPD__BINDINGS__0__SECURITY__CONTENT_TYPE_NOSNIFF=true
export SFTPGO_HTTPD__BINDINGS__0__SECURITY__REFERRER_POLICY=same-origin
export SFTPGO_HTTPD__BINDINGS__0__SECURITY__PERMISSIONS_POLICY="camera=(), microphone=(), geolocation=()"

# --- brute-force protection (bans an IP after repeated failed logins) ----------
export SFTPGO_COMMON__DEFENDER__ENABLED=true
export SFTPGO_COMMON__DEFENDER__BAN_TIME=30
export SFTPGO_COMMON__DEFENDER__THRESHOLD=15

# --- branding (files in ~/sftpgo-ui/static/drive) -------------------------------
export SFTPGO_HTTPD__BINDINGS__0__BRANDING__WEB_CLIENT__NAME="Drive"
export SFTPGO_HTTPD__BINDINGS__0__BRANDING__WEB_CLIENT__SHORT_NAME="Drive"
export SFTPGO_HTTPD__BINDINGS__0__BRANDING__WEB_CLIENT__LOGO_PATH=/drive/logo.svg
export SFTPGO_HTTPD__BINDINGS__0__BRANDING__WEB_CLIENT__FAVICON_PATH=/drive/favicon.png
export SFTPGO_HTTPD__BINDINGS__0__BRANDING__WEB_CLIENT__EXTRA_CSS=/drive/drive.css
export SFTPGO_HTTPD__BINDINGS__0__BRANDING__WEB_ADMIN__NAME="Drive Admin"
export SFTPGO_HTTPD__BINDINGS__0__BRANDING__WEB_ADMIN__SHORT_NAME="Admin"
export SFTPGO_HTTPD__BINDINGS__0__BRANDING__WEB_ADMIN__LOGO_PATH=/drive/logo.svg
export SFTPGO_HTTPD__BINDINGS__0__BRANDING__WEB_ADMIN__FAVICON_PATH=/drive/favicon.png
export SFTPGO_HTTPD__BINDINGS__0__BRANDING__WEB_ADMIN__EXTRA_CSS=/drive/drive.css
