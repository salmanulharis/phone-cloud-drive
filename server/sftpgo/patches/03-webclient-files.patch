+        // ---- phone-cloud-drive additions ----
+
+        // Keep the web session fresh while the drive is open: SFTPGo renews the
+        // session cookie on authenticated requests, so ping periodically while visible.
+        setInterval(function () {
+            if (document.visibilityState === 'visible') keepAlive();
+        }, 30 * 60 * 1000);
+        document.addEventListener('visibilitychange', function () {
+            if (document.visibilityState === 'visible') keepAlive();
+        });
+
+        // Uploads through the public Cloudflare tunnel are limited to 100 MB per request.
+        // Reject bigger files up front (with an explanation) instead of failing mid-upload.
+        const driveIsLan = /^(localhost|127\.|10\.|192\.168\.|172\.(1[6-9]|2\d|3[01])\.)/.test(location.hostname);
+        const driveMaxPublicUpload = 95 * 1024 * 1024;
+        function driveGuardSize(dz, file) {
+            if (driveIsLan || file.size <= driveMaxPublicUpload) return;
+            dz.removeFile(file);
+            ModalAlert.fire({
+                text: `"${file.name}" is ${fileSizeIEC(file.size)}. Files larger than 95 MB can't be uploaded through ${location.hostname}. Upload it on home Wi-Fi instead, at the drive's local address.`,
+                icon: "warning",
+                confirmButtonText: $.t('general.ok'),
+                customClass: { confirmButton: "btn btn-primary" }
+            });
+        }
+        dropzone.on("addedfile", file => driveGuardSize(dropzone, file));
+        dropzoneEmpty.on("addedfile", file => driveGuardSize(dropzoneEmpty, file));
+
+        // New folder name boxes: Enter creates, Escape cancels.
+        [['file_manager_new_folder_input', 'file_manager_add_folder', 'file_manager_cancel_folder'],
+         ['dirsbrowser_new_folder_input', 'dirsbrowser_add_folder', 'dirsbrowser_cancel_folder']].forEach(([input, ok, cancel]) => {
+            const el = document.getElementById(input);
+            if (!el) return;
+            el.addEventListener('keydown', e => {
+                if (e.key === 'Enter') { e.preventDefault(); document.getElementById(ok)?.click(); }
+                else if (e.key === 'Escape') { e.preventDefault(); document.getElementById(cancel)?.click(); }
+            });
+        });
+
+        // Drop files anywhere on the page: open the upload dialog with them already added.
+        if (document.getElementById('modal_upload')) {
+            let driveDragDepth = 0;
+            const driveOverlay = document.createElement('div');
+            driveOverlay.id = 'drive_drop_overlay';
+            driveOverlay.innerHTML = '<div><i class="ki-duotone ki-folder-up fs-3x"><span class="path1"></span><span class="path2"></span></i><div class="mt-3">Drop files to upload</div></div>';
+            document.body.appendChild(driveOverlay);
+            const hasFiles = e => e.dataTransfer && Array.from(e.dataTransfer.types || []).includes('Files');
+            const modalOpen = () => document.querySelector('.modal.show') !== null;
+            document.addEventListener('dragenter', e => {
+                if (!hasFiles(e) || modalOpen()) return;
+                driveDragDepth++;
+                driveOverlay.classList.add('show');
+            });
+            document.addEventListener('dragleave', e => {
+                if (!hasFiles(e)) return;
+                driveDragDepth = Math.max(0, driveDragDepth - 1);
+                if (driveDragDepth === 0) driveOverlay.classList.remove('show');
+            });
+            document.addEventListener('dragover', e => {
+                if (hasFiles(e) && !modalOpen()) e.preventDefault();
+            });
+            document.addEventListener('drop', e => {
+                driveDragDepth = 0;
+                driveOverlay.classList.remove('show');
+                if (!hasFiles(e) || modalOpen() || e.target.closest('.dropzone')) return;
+                e.preventDefault();
+                const files = Array.from(e.dataTransfer.files || []);
+                if (files.length === 0) return;
+                bootstrap.Modal.getOrCreateInstance(document.getElementById('modal_upload')).show();
+                files.forEach(f => dropzone.addFile(f));
+            });
+        }
