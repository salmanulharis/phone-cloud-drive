+
+{{- define "extra_js"}}
+<script type="text/javascript" {{- if .CSPNonce}} nonce="{{.CSPNonce}}"{{- end}}>
+    // phone-cloud-drive: a share with a single file downloads the file itself instead of a zip.
+    // Probe the uncompressed link with a 1-byte range request; keep the zip for folders / multiple files.
+    (function () {
+        const a = document.getElementById('drive_share_download');
+        if (!a) return;
+        const url = new URL(a.getAttribute('href'), location.href);
+        url.searchParams.set('compress', 'false');
+        fetch(url, { headers: { Range: 'bytes=0-0' } }).then(function (r) {
+            const type = (r.headers.get('content-type') || '').toLowerCase();
+            if ((r.status === 200 || r.status === 206) && !type.startsWith('text/html') && !type.includes('json')) {
+                a.setAttribute('href', url.pathname + url.search);
+            }
+        }).catch(function () {});
+    })();
+</script>
+{{- end}}
